# Set in the separate backend host's secure settings, never in static site files.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Exact HTTPS origin of the NEW backend, not the existing static site.
PUBLIC_BASE_URL=
TIKTOK_REDIRECT_URI=
# Real raw Fernet key, generated once and kept securely across redeployments.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=/var/lib/pararadar/tokens.sqlite3
# Keep disabled until owner approval AND TikTok audit permits wider visibility.
ALLOW_PUBLIC_POSTS=false
MAX_VIDEO_BYTES=1073741824
