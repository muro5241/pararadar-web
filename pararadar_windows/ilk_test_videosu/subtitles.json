[
  {
    "start": 0.0,
    "end": 3.5540589569160996,
    "text": "Finansal piyasalar her zaman hareketlidir."
  },
  {
    "start": 3.5540589569160996,
    "end": 6.217732426303854,
    "text": "Amerikan beş yüz endeksi buna"
  },
  {
    "start": 6.217732426303854,
    "end": 7.715102040816326,
    "text": "en iyi örnektir."
  },
  {
    "start": 7.715102040816326,
    "end": 11.174149659863945,
    "text": "Grafikte gördüğünüz aylık tarihsel veriler"
  },
  {
    "start": 11.174149659863945,
    "end": 13.233197278911565,
    "text": "genel eğilimi gösteriyor."
  },
  {
    "start": 13.233197278911565,
    "end": 16.590521541950114,
    "text": "Endeks uzun vadede yükseliş sergilese"
  },
  {
    "start": 16.590521541950114,
    "end": 19.634693877551022,
    "text": "de yol boyunca çeşitli dalgalanmalar"
  },
  {
    "start": 19.634693877551022,
    "end": 23.514104308390024,
    "text": "yaşanmıştır. Bu iniş çıkışlar piyasaların"
  },
  {
    "start": 23.514104308390024,
    "end": 25.479092970521542,
    "text": "doğal bir parçasıdır."
  },
  {
    "start": 25.479092970521542,
    "end": 28.611473922902494,
    "text": "Önemli olan kısa süreli hareketlere"
  },
  {
    "start": 28.611473922902494,
    "end": 31.50748299319728,
    "text": "değil, büyük resme odaklanmaktır."
  },
  {
    "start": 31.50748299319728,
    "end": 35.33968253968254,
    "text": "Tarihsel süreçteki bu değişimler yatırımcıya"
  },
  {
    "start": 35.33968253968254,
    "end": 37.38467120181406,
    "text": "sabırlı olmayı öğretir."
  },
  {
    "start": 37.38467120181406,
    "end": 40.97424036281179,
    "text": "Grafikteki seyir genel piyasa davranışını"
  },
  {
    "start": 40.97424036281179,
    "end": 44.90829931972789,
    "text": "özetlemektedir. Yatırım tavsiyesi değildir."
  }
]