[
  {
    "start": 0.0,
    "end": 3.206167800453515,
    "text": "Bileşik getirinin gücü zamanla ortaya"
  },
  {
    "start": 3.206167800453515,
    "end": 6.89124716553288,
    "text": "çıkar. Küçük birikimler uzun vadede"
  },
  {
    "start": 6.89124716553288,
    "end": 9.092743764172337,
    "text": "kartopu etkisi yaratır."
  },
  {
    "start": 9.092743764172337,
    "end": 12.11278911564626,
    "text": "Amerikan beş yüz endeksi grafiğine"
  },
  {
    "start": 12.11278911564626,
    "end": 15.048208616780046,
    "text": "baktığımızda bu durumu net görürüz."
  },
  {
    "start": 15.048208616780046,
    "end": 17.871156462585034,
    "text": "Endeks genel olarak yukarı yönlü"
  },
  {
    "start": 17.871156462585034,
    "end": 19.538004535147394,
    "text": "bir seyir izlemiş."
  },
  {
    "start": 19.538004535147394,
    "end": 22.035283446712018,
    "text": "Tabii ki bu yolculukta ara"
  },
  {
    "start": 22.035283446712018,
    "end": 26.01451247165533,
    "text": "dalgalanmalar yaşanmış. Önemli olan piyasa"
  },
  {
    "start": 26.01451247165533,
    "end": 29.780408163265307,
    "text": "hareketlerine değil genel trende odaklanmaktır."
  },
  {
    "start": 29.780408163265307,
    "end": 32.91251700680272,
    "text": "Sabır ve disiplin finansal büyümenin"
  },
  {
    "start": 32.91251700680272,
    "end": 37.087210884353745,
    "text": "anahtarıdır. Ekrandaki aylık tarihsel veriler"
  },
  {
    "start": 37.087210884353745,
    "end": 40.62367346938776,
    "text": "bu gelişim sürecini açıkça göstermektedir."
  },
  {
    "start": 40.62367346938776,
    "end": 44.15827664399094,
    "text": "Kendi stratejinizi belirlemek için geçmiş"
  },
  {
    "start": 44.15827664399094,
    "end": 48.291201814058965,
    "text": "verileri inceleyin. Yatırım tavsiyesi değildir."
  }
]