[
  {
    "start": 0.0,
    "end": 3.6633560090702946,
    "text": "Finansal piyasaları anlamak için endeksleri"
  },
  {
    "start": 3.6633560090702946,
    "end": 5.614058956916099,
    "text": "doğru okumak gerekir."
  },
  {
    "start": 5.614058956916099,
    "end": 8.142222222222221,
    "text": "Amerikan beş yüz endeksi bu"
  },
  {
    "start": 8.142222222222221,
    "end": 10.239818594104307,
    "text": "konuda iyi bir örnektir."
  },
  {
    "start": 10.239818594104307,
    "end": 13.634693877551019,
    "text": "Grafiğe baktığınızda genel yönün yukarı"
  },
  {
    "start": 13.634693877551019,
    "end": 17.071156462585034,
    "text": "olduğunu görebilirsiniz. Ancak bu yol"
  },
  {
    "start": 17.071156462585034,
    "end": 19.284897959183674,
    "text": "her zaman düz bir çizgi"
  },
  {
    "start": 19.284897959183674,
    "end": 22.497913832199547,
    "text": "değildir. Zaman zaman aşağı yönlü"
  },
  {
    "start": 22.497913832199547,
    "end": 26.391519274376417,
    "text": "hareketler ve dalgalanmalar yaşanması doğaldır."
  },
  {
    "start": 26.391519274376417,
    "end": 29.159909297052153,
    "text": "Önemli olan anlık değişimlere değil,"
  },
  {
    "start": 29.159909297052153,
    "end": 31.470702947845805,
    "text": "genel eğilime odaklanmaktır."
  },
  {
    "start": 31.470702947845805,
    "end": 34.66299319727891,
    "text": "İncelediğimiz bu grafik aylık tarihsel"
  },
  {
    "start": 34.66299319727891,
    "end": 38.9734693877551,
    "text": "verileri göstermektedir. Güncel fiyatları temsil"
  },
  {
    "start": 38.9734693877551,
    "end": 43.21473922902494,
    "text": "etmez. Sabırlı olmak piyasa okuryazarlığının"
  },
  {
    "start": 43.21473922902494,
    "end": 46.740272108843534,
    "text": "temelidir. Yatırım tavsiyesi değildir."
  }
]