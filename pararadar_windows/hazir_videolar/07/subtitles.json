[
  {
    "start": 0.0,
    "end": 3.7854421768707485,
    "text": "Enflasyon karşısında birikimlerinizi korumak"
  },
  {
    "start": 3.7854421768707485,
    "end": 7.780181405895692,
    "text": "oldukça önemlidir. Paranın değer kaybettiği"
  },
  {
    "start": 7.780181405895692,
    "end": 11.252879818594105,
    "text": "dönemlerde doğru araçlara yönelmek gerekir."
  },
  {
    "start": 11.252879818594105,
    "end": 13.781043083900228,
    "text": "Amerikan beş yüz endeksi bu"
  },
  {
    "start": 13.781043083900228,
    "end": 15.878639455782313,
    "text": "konuda iyi bir örnektir."
  },
  {
    "start": 15.878639455782313,
    "end": 19.645986394557823,
    "text": "Grafik üzerinden incelediğimizde endeksin uzun"
  },
  {
    "start": 19.645986394557823,
    "end": 22.22453514739229,
    "text": "vadede yukarı yönlü bir seyir"
  },
  {
    "start": 22.22453514739229,
    "end": 25.616825396825398,
    "text": "izlediğini görüyoruz. Tabii ki bu"
  },
  {
    "start": 25.616825396825398,
    "end": 29.136825396825397,
    "text": "yolculukta ara dalgalanmalar ve düşüşler"
  },
  {
    "start": 29.136825396825397,
    "end": 32.80671201814059,
    "text": "yaşanması normaldir. Önemli olan genel"
  },
  {
    "start": 32.80671201814059,
    "end": 36.76784580498866,
    "text": "eğilimi anlamaktır. Aylık tarihsel verilerin"
  },
  {
    "start": 36.76784580498866,
    "end": 39.11918367346939,
    "text": "yer aldığı bu grafik bize"
  },
  {
    "start": 39.11918367346939,
    "end": 41.840226757369614,
    "text": "piyasa hareketlerini gösteriyor."
  },
  {
    "start": 41.840226757369614,
    "end": 45.44294784580499,
    "text": "Birikimlerinizi yönetirken bu verilere göz"
  },
  {
    "start": 45.44294784580499,
    "end": 49.36285714285714,
    "text": "atabilirsiniz. Yatırım tavsiyesi değildir."
  }
]