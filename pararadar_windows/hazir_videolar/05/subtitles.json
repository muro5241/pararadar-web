[
  {
    "start": 0.0,
    "end": 2.998684807256236,
    "text": "Tek bir varlığa odaklanmak riskleri"
  },
  {
    "start": 2.998684807256236,
    "end": 6.942267573696146,
    "text": "artırır. Bu yüzden portföyü çeşitlendirmek"
  },
  {
    "start": 6.942267573696146,
    "end": 8.998367346938776,
    "text": "kritik bir stratejidir."
  },
  {
    "start": 8.998367346938776,
    "end": 12.658684807256236,
    "text": "Farklı varlıklar riskleri dağıtarak dengeli"
  },
  {
    "start": 12.658684807256236,
    "end": 14.140090702947846,
    "text": "bir yapı sunar."
  },
  {
    "start": 14.140090702947846,
    "end": 17.16013605442177,
    "text": "Amerikan beş yüz endeksi grafiğine"
  },
  {
    "start": 17.16013605442177,
    "end": 20.0124716553288,
    "text": "baktığımızda bunu net görebiliriz."
  },
  {
    "start": 20.0124716553288,
    "end": 23.074603174603176,
    "text": "Aylık verilerle hazırlanan bu grafik"
  },
  {
    "start": 23.074603174603176,
    "end": 25.308662131519277,
    "text": "genel bir eğilimi gösterir."
  },
  {
    "start": 25.308662131519277,
    "end": 28.665986394557827,
    "text": "Endeks uzun vadede yükseliş sergilese"
  },
  {
    "start": 28.665986394557827,
    "end": 31.403945578231294,
    "text": "de zaman zaman ara dalgalanmalar"
  },
  {
    "start": 31.403945578231294,
    "end": 35.72380952380953,
    "text": "yaşanmıştır. Çeşitlendirme bu dalgalı dönemlerde"
  },
  {
    "start": 35.72380952380953,
    "end": 38.45564625850341,
    "text": "portföyü korumaya yardımcı olur."
  },
  {
    "start": 38.45564625850341,
    "end": 42.428934240362814,
    "text": "Grafik üzerinden piyasa hareketlerini inceleyerek"
  },
  {
    "start": 42.428934240362814,
    "end": 46.23532879818595,
    "text": "stratejinizi geliştirebilirsiniz. Yatırım"
  },
  {
    "start": 46.23532879818595,
    "end": 48.067845804988664,
    "text": "tavsiyesi değildir."
  }
]