[
  {
    "start": 0.0,
    "end": 3.4383673469387754,
    "text": "Finansal piyasalarda geçmiş veriler yol"
  },
  {
    "start": 3.4383673469387754,
    "end": 6.968072562358277,
    "text": "gösterici olabilir. Amerikan beş yüz"
  },
  {
    "start": 6.968072562358277,
    "end": 10.05609977324263,
    "text": "endeksi genel görünümde uzun vadeli"
  },
  {
    "start": 10.05609977324263,
    "end": 12.847709750566894,
    "text": "bir yükseliş eğilimi sergilemiştir."
  },
  {
    "start": 12.847709750566894,
    "end": 15.265487528344671,
    "text": "Tabii ki bu süreç boyunca"
  },
  {
    "start": 15.265487528344671,
    "end": 18.761632653061223,
    "text": "bazı ara dalgalanmalar yaşanması oldukça"
  },
  {
    "start": 18.761632653061223,
    "end": 22.399410430839,
    "text": "doğaldır. Piyasalar her zaman doğrusal"
  },
  {
    "start": 22.399410430839,
    "end": 25.844761904761903,
    "text": "ilerlemez. Önemli olan genel trendi"
  },
  {
    "start": 25.844761904761903,
    "end": 29.592199546485258,
    "text": "doğru okumaktır. Önünüzdeki grafik aylık"
  },
  {
    "start": 29.592199546485258,
    "end": 32.41260770975057,
    "text": "tarihsel verileri göstermektedir."
  },
  {
    "start": 32.41260770975057,
    "end": 35.293242630385485,
    "text": "Bu veriler bugünün fiyatını temsil"
  },
  {
    "start": 35.293242630385485,
    "end": 39.85034013605442,
    "text": "etmez. Geçmiş performans gelecekteki sonuçların"
  },
  {
    "start": 39.85034013605442,
    "end": 44.23972789115646,
    "text": "garantisi değildir. Grafik üzerindeki hareketleri"
  },
  {
    "start": 44.23972789115646,
    "end": 47.90403628117914,
    "text": "inceleyerek piyasa yapısını anlayabilirsiniz."
  },
  {
    "start": 47.90403628117914,
    "end": 50.307482993197276,
    "text": "Yatırım tavsiyesi değildir."
  }
]