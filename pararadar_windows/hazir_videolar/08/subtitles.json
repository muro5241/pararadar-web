[
  {
    "start": 0.0,
    "end": 3.1178684807256234,
    "text": "Yatırım yaparken zaman kavramı çok"
  },
  {
    "start": 3.1178684807256234,
    "end": 6.518458049886621,
    "text": "önemlidir. Amerikan beş yüz endeksi"
  },
  {
    "start": 6.518458049886621,
    "end": 9.140680272108844,
    "text": "üzerinden bunu inceleyebiliriz."
  },
  {
    "start": 9.140680272108844,
    "end": 13.279637188208618,
    "text": "Grafiklere baktığımızda piyasaların genel yönünün"
  },
  {
    "start": 13.279637188208618,
    "end": 15.379002267573696,
    "text": "yukarı olduğunu görürüz."
  },
  {
    "start": 15.379002267573696,
    "end": 17.85201814058957,
    "text": "Ancak bu yolculuk her zaman"
  },
  {
    "start": 17.85201814058957,
    "end": 20.69106575963719,
    "text": "düz bir çizgi şeklinde ilerlemez."
  },
  {
    "start": 20.69106575963719,
    "end": 23.34326530612245,
    "text": "Zaman zaman sert düşüşler ve"
  },
  {
    "start": 23.34326530612245,
    "end": 27.787573696145127,
    "text": "dalgalanmalar yaşanabilir. Sabırlı olmak riskleri"
  },
  {
    "start": 27.787573696145127,
    "end": 30.002857142857145,
    "text": "yönetmenin temel yoludur."
  },
  {
    "start": 30.002857142857145,
    "end": 32.88639455782313,
    "text": "Uzun vadeli bakış açısı piyasa"
  },
  {
    "start": 32.88639455782313,
    "end": 37.08408163265306,
    "text": "gürültüsünü azaltır. Önünüzdeki aylık tarihsel"
  },
  {
    "start": 37.08408163265306,
    "end": 39.427301587301585,
    "text": "veriler bu genel seyri net"
  },
  {
    "start": 39.427301587301585,
    "end": 41.83687074829932,
    "text": "bir şekilde göstermektedir."
  },
  {
    "start": 41.83687074829932,
    "end": 45.33814058956916,
    "text": "Grafikteki hareketleri dikkatle inceleyin."
  },
  {
    "start": 45.33814058956916,
    "end": 47.741587301587295,
    "text": "Yatırım tavsiyesi değildir."
  }
]