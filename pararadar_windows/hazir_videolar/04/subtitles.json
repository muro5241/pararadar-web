[
  {
    "start": 0.0,
    "end": 3.708253968253968,
    "text": "Piyasalarda hareketlilik her zaman mevcuttur."
  },
  {
    "start": 3.708253968253968,
    "end": 6.689387755102041,
    "text": "Amerikan beş yüz endeksi üzerinden"
  },
  {
    "start": 6.689387755102041,
    "end": 9.959274376417234,
    "text": "baktığımızda genel eğilimin yukarı yönlü"
  },
  {
    "start": 9.959274376417234,
    "end": 13.36263038548753,
    "text": "olduğunu görüyoruz. Ancak bu yolculuk"
  },
  {
    "start": 13.36263038548753,
    "end": 15.576371882086168,
    "text": "her zaman düz bir çizgi"
  },
  {
    "start": 15.576371882086168,
    "end": 19.14371882086168,
    "text": "şeklinde ilerlemez. Zaman zaman sert"
  },
  {
    "start": 19.14371882086168,
    "end": 22.892108843537414,
    "text": "geri çekilmeler ve dalgalanmalar yaşanabilir."
  },
  {
    "start": 22.892108843537414,
    "end": 25.758321995464854,
    "text": "Bu durumlar yatırımcılar için risk"
  },
  {
    "start": 25.758321995464854,
    "end": 29.225623582766442,
    "text": "oluşturur. Önemli olan bu süreçleri"
  },
  {
    "start": 29.225623582766442,
    "end": 33.39392290249433,
    "text": "doğru yönetebilmektir. Önünüzdeki grafik aylık"
  },
  {
    "start": 33.39392290249433,
    "end": 36.21433106575964,
    "text": "tarihsel verileri göstermektedir."
  },
  {
    "start": 36.21433106575964,
    "end": 39.68086167800453,
    "text": "Geçmişteki iniş çıkışlar piyasanın doğal"
  },
  {
    "start": 39.68086167800453,
    "end": 43.25845804988662,
    "text": "bir parçasıdır. Grafiği inceleyerek bu"
  },
  {
    "start": 43.25845804988662,
    "end": 46.16013605442177,
    "text": "döngüleri daha iyi anlayabilirsiniz."
  },
  {
    "start": 46.16013605442177,
    "end": 48.56358276643991,
    "text": "Yatırım tavsiyesi değildir."
  }
]