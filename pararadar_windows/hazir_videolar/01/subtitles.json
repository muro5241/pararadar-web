[
  {
    "start": 0.0,
    "end": 3.5540589569160996,
    "text": "Finansal piyasalar her zaman hareketlidir."
  },
  {
    "start": 3.5540589569160996,
    "end": 6.535192743764172,
    "text": "Amerikan beş yüz endeksi üzerinden"
  },
  {
    "start": 6.535192743764172,
    "end": 9.805079365079365,
    "text": "baktığımızda genel eğilimin yukarı yönlü"
  },
  {
    "start": 9.805079365079365,
    "end": 13.20843537414966,
    "text": "olduğunu görüyoruz. Ancak bu yolculuk"
  },
  {
    "start": 13.20843537414966,
    "end": 15.897777777777778,
    "text": "hiçbir zaman dümdüz ilerlemez."
  },
  {
    "start": 15.897777777777778,
    "end": 18.719183673469388,
    "text": "Grafiklerde ara ara düşüşler ve"
  },
  {
    "start": 18.719183673469388,
    "end": 22.130884353741497,
    "text": "dalgalanmalar yaşanması oldukça doğaldır."
  },
  {
    "start": 22.130884353741497,
    "end": 25.286984126984127,
    "text": "Önemli olan bu hareketlerin piyasanın"
  },
  {
    "start": 25.286984126984127,
    "end": 28.120816326530612,
    "text": "genel yapısında olduğunu anlamaktır."
  },
  {
    "start": 28.120816326530612,
    "end": 31.389115646258503,
    "text": "Paylaştığımız bu grafik aylık tarihsel"
  },
  {
    "start": 31.389115646258503,
    "end": 35.366031746031744,
    "text": "verileri göstermektedir. Güncel fiyatları değil,"
  },
  {
    "start": 35.366031746031744,
    "end": 38.435691609977326,
    "text": "geçmişteki genel seyri temsil eder."
  },
  {
    "start": 38.435691609977326,
    "end": 40.997188208616784,
    "text": "Sabırlı olmak ve büyük resme"
  },
  {
    "start": 40.997188208616784,
    "end": 44.750612244897965,
    "text": "odaklanmak finansal okuryazarlığın temelidir."
  },
  {
    "start": 44.750612244897965,
    "end": 47.1540589569161,
    "text": "Yatırım tavsiyesi değildir."
  }
]