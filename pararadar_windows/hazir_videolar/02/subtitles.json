[
  {
    "start": 0.0,
    "end": 3.3494784580498864,
    "text": "Yatırım dünyasında doğru zamanı beklemek"
  },
  {
    "start": 3.3494784580498864,
    "end": 5.167165532879818,
    "text": "çoğu zaman zordur."
  },
  {
    "start": 5.167165532879818,
    "end": 8.14829931972789,
    "text": "Amerikan beş yüz endeksi üzerinden"
  },
  {
    "start": 8.14829931972789,
    "end": 11.509841269841269,
    "text": "baktığımızda piyasaların genel eğilimini"
  },
  {
    "start": 11.509841269841269,
    "end": 15.704535147392289,
    "text": "görebiliriz. Grafiklerdeki aylık veriler bize"
  },
  {
    "start": 15.704535147392289,
    "end": 18.91986394557823,
    "text": "uzun vadeli yükseliş trendini gösterir."
  },
  {
    "start": 18.91986394557823,
    "end": 22.281541950113375,
    "text": "Elbette bu yolculukta ara dalgalanmalar"
  },
  {
    "start": 22.281541950113375,
    "end": 24.71945578231292,
    "text": "yaşanması oldukça doğaldır."
  },
  {
    "start": 24.71945578231292,
    "end": 28.081133786848067,
    "text": "Önemli olan piyasa hareketlerine rağmen"
  },
  {
    "start": 28.081133786848067,
    "end": 32.44829931972789,
    "text": "düzenli kalabilmektir. Zamanlama hatasına düşmek"
  },
  {
    "start": 32.44829931972789,
    "end": 35.80734693877551,
    "text": "yerine disiplinli ilerlemek stratejik bir"
  },
  {
    "start": 35.80734693877551,
    "end": 39.84816326530612,
    "text": "yaklaşımdır. Ekrandaki tarihsel veriler bu"
  },
  {
    "start": 39.84816326530612,
    "end": 42.83396825396825,
    "text": "genel seyri açıkça ortaya koyuyor."
  },
  {
    "start": 42.83396825396825,
    "end": 46.034195011337864,
    "text": "Süreci grafik üzerinden takip ederek"
  },
  {
    "start": 46.034195011337864,
    "end": 50.21482993197279,
    "text": "mantığı kavrayabilirsiniz. Yatırım tavsiyesi"
  },
  {
    "start": 50.21482993197279,
    "end": 51.222312925170066,
    "text": "değildir."
  }
]