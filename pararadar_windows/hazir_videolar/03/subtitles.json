[
  {
    "start": 0.0,
    "end": 3.3170068027210884,
    "text": "Yatırımlarınızda nominal getiri ile reel"
  },
  {
    "start": 3.3170068027210884,
    "end": 6.361995464852608,
    "text": "getiri arasındaki farkı bilmek çok"
  },
  {
    "start": 6.361995464852608,
    "end": 10.248934240362813,
    "text": "önemlidir. Nominal getiri sadece rakamsal"
  },
  {
    "start": 10.248934240362813,
    "end": 13.56390022675737,
    "text": "artışı gösterir. Reel getiri ise"
  },
  {
    "start": 13.56390022675737,
    "end": 16.06077097505669,
    "text": "satın alma gücünüzü yansıtır."
  },
  {
    "start": 16.06077097505669,
    "end": 19.080816326530613,
    "text": "Amerikan beş yüz endeksi grafiğine"
  },
  {
    "start": 19.080816326530613,
    "end": 22.27374149659864,
    "text": "baktığımızda uzun vadeli bir yükseliş"
  },
  {
    "start": 22.27374149659864,
    "end": 25.47233560090703,
    "text": "görüyoruz. Tabii bu süreçte ara"
  },
  {
    "start": 25.47233560090703,
    "end": 28.88403628117914,
    "text": "dalgalanmalar yaşanması oldukça doğaldır."
  },
  {
    "start": 28.88403628117914,
    "end": 32.31650793650794,
    "text": "Grafik üzerindeki aylık tarihsel veriler"
  },
  {
    "start": 32.31650793650794,
    "end": 35.380589569161,
    "text": "genel eğilimi anlamamıza yardımcı olur."
  },
  {
    "start": 35.380589569161,
    "end": 38.81882086167801,
    "text": "Reel kazancı hesaplamak için enflasyon"
  },
  {
    "start": 38.81882086167801,
    "end": 42.026303854875295,
    "text": "etkisini göz önünde bulundurmalısınız."
  },
  {
    "start": 42.026303854875295,
    "end": 45.647709750566904,
    "text": "Bu temel kavramlar finansal okuryazarlığın"
  },
  {
    "start": 45.647709750566904,
    "end": 49.51891156462586,
    "text": "merkezindedir. Yatırım tavsiyesi değildir."
  }
]